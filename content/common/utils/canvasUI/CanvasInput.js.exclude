import { TextCanvasMeasurer } from './TextCanvasMeasurer.js';

export class CanvasInput {
    constructor({ value = "", placeholder = "", onUpdate, onCommit, appInstance, options = {} }) {
        this.app = appInstance;
        this.element = document.createElement('div');
        this.element.className = 'canvas-input-wrapper';
        this.canvas = document.createElement('canvas');
        this.element.appendChild(this.canvas);
        this.ctx = this.canvas.getContext("2d");
        this.ctx.imageSmoothingEnabled = false;
        this.value = value;
        this.placeholder = placeholder;
        this.onUpdate = onUpdate;
        this.onCommit = onCommit || onUpdate; // Fallback to onUpdate for backward compatibility
        this.isFocused = false;
        this.cursorVisible = false;
        this.options = {
            backgroundColor: options.backgroundColor || "rgba(0,0,0,0.1)",
            textColor: options.textColor || "black",
            placeholderColor: options.placeholderColor || "rgba(0,0,0,0.5)",
            borderColor: options.borderColor,
            focusBorderColor: options.focusBorderColor,
            borderRadius: options.borderRadius !== undefined ? options.borderRadius : 4,
            shadow: options.shadow || { color: "rgba(0, 0, 0, 0.2)", blur: 4, offsetX: 0, offsetY: 2 },
            cursorColor: options.cursorColor || options.textColor || "black"
        };
        this.element.tabIndex = 0;
        this.element.addEventListener("focus", this.handleFocus.bind(this));
        this.element.addEventListener("blur", this.handleBlur.bind(this));
        this.element.addEventListener("keydown", this.handleKeyDown.bind(this));
        this.cursorInterval = null;
        this.resize();
    }

    resize() {
        const rect = this.element.getBoundingClientRect();
        if (rect.width === 0) return;
        this.canvas.width = rect.width;
        this.canvas.height = rect.height;
        this.draw();
    }

    draw() {
        const ctx = this.ctx;
        const { width, height } = this.canvas.getBoundingClientRect();
        ctx.clearRect(0, 0, width, height);

        // Draw background with rounded corners and subtle shadow
        ctx.save();
        if (this.options.shadow) {
            ctx.shadowColor = this.options.shadow.color;
            ctx.shadowBlur = this.options.shadow.blur;
            ctx.shadowOffsetX = this.options.shadow.offsetX;
            ctx.shadowOffsetY = this.options.shadow.offsetY;
        }
        ctx.fillStyle = this.options.backgroundColor;
        ctx.beginPath();
        ctx.roundRect(0, 0, width, height, this.options.borderRadius);
        ctx.fill();
        ctx.restore();

        // Border
        const borderColor = this.isFocused ? this.options.focusBorderColor : this.options.borderColor;
        if (borderColor) {
            ctx.strokeStyle = borderColor;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.roundRect(0.5, 0.5, width - 1, height - 1, this.options.borderRadius - 0.5);
            ctx.stroke();
        }

        // Text
        const textX = 10;
        const textY = height / 2;
        if (this.value) {
            this.app._drawTextOnCanvas(
                ctx,
                this.value,
                textX,
                textY,
                '14px "Rodin", sans-serif',
                this.options.textColor,
                "left",
                "middle"
            );
        } else {
            this.app._drawTextOnCanvas(
                ctx,
                this.placeholder,
                textX,
                textY,
                '14px "Rodin", sans-serif',
                this.options.placeholderColor,
                "left",
                "middle"
            );
        }

        // Cursor
        if (this.isFocused && this.cursorVisible) {
            ctx.font = '14px "Rodin", sans-serif';
            const textWidth = ctx.measureText(this.value).width;
            ctx.fillStyle = this.options.cursorColor;
            ctx.fillRect(textX + textWidth + 1, textY - 8, 1, 16);
        }
    }

    handleFocus() {
        if (this.app && this.app.sounds && this.app.sounds.inputFocus) {
            this.app.sounds.inputFocus.play();
        }
        this.isFocused = true;
        if (this.cursorInterval) clearInterval(this.cursorInterval);
        this.cursorVisible = true;
        this.cursorInterval = setInterval(() => {
            this.cursorVisible = !this.cursorVisible;
            this.draw();
        }, 500);
        this.draw();
    }

    handleBlur() {
        if (this.app && this.app.sounds && this.app.sounds.inputBlur) {
            this.app.sounds.inputBlur.play();
        }
        this.isFocused = false;
        if (this.cursorInterval) clearInterval(this.cursorInterval);
        this.cursorInterval = null;
        this.cursorVisible = false;
        this.draw();
        if (this.onCommit) {
            this.onCommit(this.value);
        }
    }

    handleKeyDown(e) {
        if (e.key === "Backspace") {
            this.value = this.value.slice(0, -1);
            if (this.app && this.app.sounds && this.app.sounds.typing) {
                this.app.sounds.typing.play("s" + Math.floor(Math.random() * 3 + 1));
            }
        } else if (e.key.length === 1 && !e.metaKey && !e.ctrlKey) {
            this.value += e.key;
            if (this.app && this.app.sounds && this.app.sounds.typing) {
                this.app.sounds.typing.play("s" + Math.floor(Math.random() * 3 + 1));
            }
        } else if (e.key === "Enter") {
            this.element.blur();
        } else {
            return;
        }
        e.preventDefault();
        if (this.onUpdate) {
            this.onUpdate(this.value);
        }
        this.draw();
    }

    setValue(newValue) {
        this.value = newValue;
        this.draw();
    }

    setPlaceholder(newPlaceholder) {
        this.placeholder = newPlaceholder;
        this.draw();
    }
}